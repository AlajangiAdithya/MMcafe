VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_RAZORPAY_KEY=rzp_test_or_live_key

# Bunny.net Stream (secure video hosting for academy)
VITE_BUNNY_LIBRARY_ID=your-bunny-library-id
# VITE_BUNNY_TOKEN_KEY=your-token-key (optional, for signed URLs)

# EmailJS (order confirmation emails)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your-public-key
# Cafe inbox that gets a "new order placed" alert (leave blank to disable)
VITE_CAFE_NOTIFY_EMAIL=orders@mastermindcafe.in
# Optional dedicated templates (each set up as pass-through: {{subject}} + {{{content_html}}}).
# Leave blank to reuse VITE_EMAILJS_TEMPLATE_ID.
VITE_EMAILJS_CAFE_TEMPLATE_ID=
VITE_EMAILJS_DELIVERED_TEMPLATE_ID=

# Google Analytics 4 (optional — only loads if user consents)
VITE_GA_MEASUREMENT_ID=

